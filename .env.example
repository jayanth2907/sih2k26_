# ==============================================================================
# PS26080: ENVIRONMENT TEMPLATE (DO NOT PUT REAL SECRETS HERE)
# ==============================================================================

# Application Configuration
APP_NAME=MEGHANETRA_PS26080
APP_ENV=development
APP_PORT=8000
DEBUG=false

# Copernicus Climate Data Store (CDS API for ERA5 Reanalysis)
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
CDS_API_KEY=your_uid:your_cds_api_key_here

# NCMRWF Institutional Gateway (when activated)
NCMRWF_GATEWAY_URL=https://internal.ncmrwf.gov.in/opendap
NCMRWF_API_TOKEN=your_ncmrwf_token_here

# External NWP Fallback (NOAA GFS via Open-Meteo)
NWP_BASE_URL=https://api.open-meteo.com/v1/gfs
NWP_MODEL=gfs_seamless

# Model Artifacts Base Directory
ARTIFACTS_DIR=artifacts/models
